/target
# `#[sqlx::test]` puts one SQLite database per test in `target/sqlx/test-dbs/`,
# relative to the *test's* working directory — which nextest sets to the crate
# root, not the workspace root. So the store crate grows a `target/` of its own
# the first time the conformance suite runs.
crates/*/target/
dev/*/target/
**/*.rs.bk
*.pdb

# Coverage artefacts
/coverage
/lcov.info
*.profraw
*.profdata

# cargo-mutants
/mutants.out
/mutants.out.old

# mdBook output
/docs/book

# Local dev state
/.env
*.db
*.db-shm
*.db-wal
/data

# insta review leftovers
**/*.snap.new

# Editors
.idea/
.vscode/
*.swp
.DS_Store
